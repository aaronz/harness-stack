{
  "name": "ai-readiness-evaluator",
  "version": "1.0.0",
  "description": "AI Coding可落地性评估系统 - Evaluate development requirements for AI Coding implementability",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "server": "ts-node src/server/index.ts",
    "db:migrate": "ts-node src/db/migrate.ts",
    "type-check": "tsc --noEmit",
    "start:all": "npm run server & npm run dev",
    "stop:all": "pkill -f 'ts-node src/server' && pkill -f 'next dev'"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "express": "^4.18.2",
    "sql.js": "^1.10.0",
    "cors": "^2.8.5",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/express": "^4.17.21",
    "@types/sql.js": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "prettier": "^3.2.0"
  }
}
